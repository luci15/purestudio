# Set these in Vercel > Project > Settings > Environment Variables (server-side only).
# Generate SESSION_SECRET and CRON_SECRET with:  node scripts/setup-auth.js

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# anon / publishable key. Used ONLY by the server to talk to Supabase Auth. Never put it in client code.
SUPABASE_ANON_KEY=your-anon-key
# service_role / secret key. NEVER expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The super admin(s): full access, including Users and Security. List one or several, separated by commas.
# Create each of these in Supabase > Authentication > Users (Add user, auto-confirm) and turn OFF
# "Allow new users to sign up". Staff are optional and are added from inside the app.
OWNER_EMAIL=owner@example.com, second-admin@example.com
# Optional: total accounts allowed, counting every super admin + staff (default 3, max 10).
# Set it equal to the number of super admins to allow no staff at all.
MAX_USERS=2

# Random string, at least 32 characters. Changing it signs everyone out.
SESSION_SECRET=at-least-32-random-characters
# Optional: session length in hours (default 24, max 720)
SESSION_HOURS=24

# Protects the daily keep-alive cron (/api/keepalive)
CRON_SECRET=random-string

# Optional: your site URL, used as the target of password-reset emails (defaults to the request host).
# Must also be listed in Supabase > Authentication > URL Configuration.
SITE_URL=https://your-app.vercel.app
