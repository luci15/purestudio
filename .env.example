# Set these in Vercel > Project > Settings > Environment Variables (server-side only), then redeploy.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# service_role / secret key. NEVER expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time guard for the FIRST visit: you type this together with the password you choose. Pick any long phrase.
# After the password exists, setup is closed for good and this value is no longer used.
SETUP_CODE=choose-a-long-private-phrase

# Optional: session length in hours (default 24, max 720)
SESSION_HOURS=24

# Optional: protects the daily keep-alive job (/api/keepalive) that stops the free Supabase project pausing
CRON_SECRET=random-string
